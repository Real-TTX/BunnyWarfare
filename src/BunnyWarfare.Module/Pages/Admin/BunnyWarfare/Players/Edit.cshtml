@page "/Admin/BunnyWarfare/Players/Edit"
@model BunnyWarfare.Pages.Admin.Players.EditModel
@{
    ViewData["Title"] = Model.DisplayName;
    ViewData["PageSub"] = Model.Stats?.IsGuest == true ? "Gast · Konto und Anmeldung verwaltet MatGame" : "Konto und Anmeldung verwaltet MatGame";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", "/Admin"), ("BunnyWarfare", "/Admin/BunnyWarfare"), ("Spieler", "/Admin/BunnyWarfare/Players"), (Model.DisplayName, null) };
    ViewData["Width"] = "narrow";
    var tab = Model.Tab;
}
<partial name="_Assets" />

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />

    @* the areas of a player are tabs: the team, the progress (experience and look) and the statistics *@
    <div data-tabs>
        <md-tab-group label="Bereiche des Spielers">
            <md-tab-button panel="player-general" icon="user" active="@(tab == "general")">Team</md-tab-button>
            <md-tab-button panel="player-progress" icon="star" active="@(tab == "progress")">Fortschritt</md-tab-button>
            <md-tab-button panel="player-stats" icon="bar-chart" active="@(tab == "stats")">Statistik</md-tab-button>
        </md-tab-group>

        <md-tab-panel id="player-general" active="@(tab == "general")">
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="TeamName" label="Teamname" required value="@Model.TeamName" maxlength="40" />
                    <md-field name="TeamColor" kind="colour" label="Teamfarbe" value="@Model.TeamColor" options="Model.Colors" />
                </div>
            </div>
        </md-tab-panel>

        <md-tab-panel id="player-progress" active="@(tab == "progress")">
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="Xp" kind="number" label="Erfahrung (XP)" value="@Model.Xp.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" mono="true"
                              hint="@($"Level {Model.Level} von {Cosmetics.MaxLevel} · Level {Math.Min(Cosmetics.MaxLevel, Model.Level + 1)} ab {Cosmetics.XpAt(Math.Min(Cosmetics.MaxLevel, Model.Level + 1))} XP")" />
                    <md-field name="Fur" kind="select" label="Fell" value="@Model.Fur" options="Model.ChoicesOf(Cosmetics.Furs)" />
                    <md-field name="Outfit" kind="select" label="Hut" value="@Model.Outfit" options="Model.ChoicesOf(Cosmetics.Outfits)" />
                    <md-field name="Face" kind="select" label="Gesicht" value="@Model.Face" options="Model.ChoicesOf(Cosmetics.Faces)" />
                    <md-field name="Frame" kind="select" label="Porträtrahmen" value="@Model.Frame" options="Model.ChoicesOf(Cosmetics.Frames)"
                              hint="Die Administration darf auch gesperrte Sachen vergeben." />
                </div>
            </div>
        </md-tab-panel>

        @if (Model.Stats is { } s)
        {
            <md-tab-panel id="player-stats" active="@(tab == "stats")">
                <div class="mat-card">
                    <div class="mat-card__body">
                        <dl class="mat-kv">
                            <dt>Spiele</dt><dd class="mat-mono">@s.GamesPlayed</dd>
                            <dt>Siege</dt><dd class="mat-mono">@s.GamesWon</dd>
                            <dt>Erledigte Hasen</dt><dd class="mat-mono">@s.Kills</dd>
                            <dt>Schaden</dt><dd class="mat-mono">@s.DamageDealt</dd>
                            <dt>Zuletzt gesehen</dt><dd class="mat-mono">@Ui.Stamp(s.LastSeenDate)</dd>
                            <dt>Erstes Spiel</dt><dd class="mat-mono">@Ui.Stamp(s.CreateDate)</dd>
                            <dt>Konto-Nummer</dt><dd class="mat-mono">@s.Id</dd>
                        </dl>
                    </div>
                </div>
            </md-tab-panel>
        }
    </div>

    <md-buttons save="Speichern" back="/Admin/BunnyWarfare/Players" delete-handler="Delete" delete-label="Entfernen"
                delete-confirm="@($"{Model.DisplayName} aus BunnyWarfare entfernen? Statistik und Fortschritt sind dann weg, das Konto in MatGame bleibt.")" />
</form>
