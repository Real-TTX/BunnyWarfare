@page "/Play"
@model BunnyWarfare.Pages.Play.IndexModel
@{
    ViewData["Title"] = "Offene Spiele";
    ViewData["PageSub"] = "Öffentliche Lobbys zum Mitmachen und deine laufenden Spiele.";
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Items.Count == 0)
    {
        <partial name="_Empty" model="@(new EmptyStateModel("swords", Model.Toolbar.Total == 0 ? "Gerade ist keine Lobby offen" : "Kein Spiel gefunden", Model.Toolbar.Total == 0 ? "Mach selbst eins auf – die anderen finden es hier." : "Ändere die Suche oder die Filter.", Model.Toolbar.Total == 0, "/Play/New", "Neues Spiel", Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <md-table caption="Offene Spiele">
            <thead>
                <tr><th scope="col">Spiel</th><th scope="col">Welt</th><th scope="col" class="mat-hide-sm">Gastgeber</th><th scope="col">Teams</th><th scope="col" class="mat-hide-sm">Regeln</th><th scope="col">Status</th><th scope="col"><span class="mat-sr-only">Aktionen</span></th></tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    var seats = Model.SeatsTaken(m.Token);
                    <tr>
                        <td data-label="Spiel"><a href="/Play/@m.Token">@m.Name</a>@if (m.IsMine) { <small class="mat-muted"> · deins</small> }</td>
                        <td data-label="Welt">@WorldLogic.ThemeName(m.Theme) <small class="mat-muted">@m.WorldName</small></td>
                        <td data-label="Gastgeber" class="mat-hide-sm">@m.HostName</td>
                        <td data-label="Teams" class="mat-mono">@(seats?.ToString() ?? "–") / @m.MaxTeams</td>
                        <td data-label="Regeln" class="mat-hide-sm">@m.BunniesPerTeam Hasen · @m.TurnSeconds s</td>
                        <td data-label="Status">
                            @if (m.Status == MatchStatus.Running) { <span class="mat-pill mat-pill--warn">Läuft</span> } else { <span class="mat-pill mat-pill--ok">Lobby</span> }
                        </td>
                        <td class="mat-table__cell-actions"><div class="mat-table__actions"><a class="mat-btn mat-btn--primary mat-btn--sm" href="/Play/@m.Token">@Ui.Icon(m.Status == MatchStatus.Running ? "eye" : "play")<span>@(m.Status == MatchStatus.Running ? (m.IsMine ? "Weiter" : "Zuschauen") : "Beitreten")</span></a></div></td>
                    </tr>
                }
            </tbody>
        </md-table>
    }

    <partial name="_Pager" model="Model.Pager" />

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Play/New">@Ui.Icon("plus")<span>Neues Spiel</span></a>
        <a class="mat-btn mat-btn--secondary" href="/Play">@Ui.Icon("refresh")<span>Aktualisieren</span></a>
    </div>
</div>
