@page "/Play/New"
@model BunnyWarfare.Pages.Play.NewModel
@{
    ViewData["Title"] = "Neues Spiel";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Spielen", "/Play"), ("Neues Spiel", null) };
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">Spiel</h2></div>
        <div class="mat-card__body mat-form">
            <md-field name="Name" label="Name" required value="@Model.Name" maxlength="60" />
            <md-field name="WorldId" kind="select" label="Welt" required value="@Model.WorldId" options="Model.Worlds" />
            <md-field name="IsPublic" kind="switch" label="Öffentlich (unter „Offene Spiele“ zu finden)" value="@Model.IsPublic.ToString()" hint="Ein privates Spiel erreicht nur, wer den Link hat." />
        </div>
    </div>
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">Regeln</h2></div>
        <div class="mat-card__body mat-form mat-grid mat-grid--2">
            <md-field name="MaxTeams" kind="number" label="Teams (höchstens)" required value="@Model.MaxTeams" min="2" max="@Model.MaxTeamsLimit.ToString()" />
            <md-field name="BunniesPerTeam" kind="number" label="Hasen pro Team" required value="@Model.BunniesPerTeam" min="1" max="6" />
            <md-field name="BunnyHealth" kind="number" label="Gesundheit pro Hase" required value="@Model.BunnyHealth" min="25" max="300" step="5" />
            <md-field name="TurnSeconds" kind="number" label="Zugzeit (Sekunden)" required value="@Model.TurnSeconds" min="15" max="120" step="5" />
        </div>
    </div>
    <md-buttons save="Lobby öffnen" save-icon="play" back="/Play" />
</form>
