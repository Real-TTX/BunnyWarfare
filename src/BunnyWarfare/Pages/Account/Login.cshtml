@page "/Account/Login"
@model BunnyWarfare.Pages.Account.LoginModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Anmelden";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand bw-auth__brand">
        <img src="~/img/logo/bunnywarfare-mark.svg" alt="" width="72" height="72" />
        <h1>Anmelden</h1>
        <p class="mat-muted">Die Löffel gespitzt? Melde dich an und zieh in die Schlacht.</p>
    </div>

    <form class="mat-form" method="post" novalidate id="login-form">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <partial name="_FormSummary" model="ViewData.ModelState" />
        <md-field name="LoginName" label="Anmeldename" required autocomplete="username" value="@Model.LoginName" autofocus />
        <md-field name="Password" kind="password" label="Passwort" required autocomplete="current-password" />
        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("login")<span>Anmelden</span></button>
        </div>
        @if (Model.CanRegister)
        {
            <p class="mat-muted">Noch kein Konto? <a href="/Account/Register">Jetzt registrieren</a></p>
        }
    </form>
</div>
