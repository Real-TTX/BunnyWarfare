@page "/"
@model BunnyWarfare.Pages.IndexModel
@{
    ViewData["Title"] = "Start";
    ViewData["OwnHead"] = true;
}

<section class="bw-hero">
    <img class="bw-hero__art" src="~/img/logo/bunnywarfare-hero.svg" alt="BunnyWarfare" width="512" height="256" />
    <div class="bw-hero__text">
        <h1>Hallo, @Model.Me.DisplayName!</h1>
        <p>Rundenbasierte Hasenschlacht in 3D: Karotten werfen, Rüben rollen lassen, Krater graben – allein gegen Bots oder mit Freunden.</p>
        <form method="post" asp-page-handler="Quick" class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--lg">@Ui.Icon("play")<span>Schnellspiel gegen Bots</span></button>
            <a class="mat-btn mat-btn--secondary mat-btn--lg" href="/Play/New">@Ui.Icon("plus")<span>Neues Spiel</span></a>
            <a class="mat-btn mat-btn--ghost mat-btn--lg" href="/Play">@Ui.Icon("swords")<span>Offene Spiele</span></a>
        </form>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Announcement))
{
    <div class="mat-alert mat-alert--info" role="status">
        @Ui.Icon("bell")
        <div class="mat-alert__body">@Model.Announcement</div>
    </div>
}

<div class="mat-grid mat-grid--2 bw-gap">
    <section class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">So wird gespielt</h2></div>
        <div class="mat-card__body">
            <ul class="bw-keys">
                <li><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> laufen (begrenzte Ausdauer pro Zug)</li>
                <li><kbd>Maus ziehen</kbd> Kamera drehen und zielen · <kbd>Mausrad</kbd> zoomen</li>
                <li><kbd>↑</kbd><kbd>↓</kbd> oder <kbd>R</kbd><kbd>F</kbd> Rohr heben und senken</li>
                <li><kbd>Leertaste</kbd> halten = Kraft laden, loslassen = Feuer</li>
                <li><kbd>1</kbd>–<kbd>9</kbd> Waffe wählen · Luftschlag: Ziel auf der Karte anklicken</li>
                <li><kbd>Enter</kbd> Chat · <kbd>Tab</kbd> Zug beenden</li>
            </ul>
        </div>
    </section>

    <section class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">Deine letzten Spiele</h2></div>
        @if (Model.History.Count == 0)
        {
            <div class="mat-card__body"><p class="mat-muted">Noch keine Spiele – Zeit für die erste Schlacht!</p></div>
        }
        else
        {
            <md-table caption="Deine letzten Spiele">
                <thead>
                    <tr><th scope="col">Spiel</th><th scope="col">Welt</th><th scope="col">Platz</th><th scope="col" class="mat-num">Treffer</th><th scope="col" class="mat-hide-sm">Ende</th></tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.History)
                    {
                        <tr>
                            <td data-label="Spiel">@h.Name</td>
                            <td data-label="Welt">@h.WorldName</td>
                            <td data-label="Platz">
                                @if (h.Status == MatchStatus.Aborted) { <span class="mat-pill mat-pill--plain">abgebrochen</span> }
                                else if (h.Placement == 1) { <span class="mat-pill mat-pill--ok">@Ui.Icon("trophy") Sieg</span> }
                                else { <span class="mat-pill mat-pill--plain">@h.Placement.</span> }
                            </td>
                            <td data-label="Treffer" class="mat-num mat-mono">@h.Kills</td>
                            <td data-label="Ende" class="mat-mono mat-hide-sm">@Ui.Stamp(h.EndDate)</td>
                        </tr>
                    }
                </tbody>
            </md-table>
        }
    </section>
</div>
