@page "/Admin/Players/Edit"
@model BunnyWarfare.Pages.Admin.Players.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neuer Spieler" : Model.DisplayName;
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", "/Admin"), ("Spieler", "/Admin/Players"), (Model.IsNew ? "Neu" : Model.DisplayName, null) };
    ViewData["Width"] = "narrow";
    var tab = Model.Tab;
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />

    @* the areas of a player are tabs: general, security and – for an existing one – the statistics *@
    <div data-tabs>
        <md-tab-group label="Bereiche des Spielers">
            <md-tab-button panel="player-general" icon="user" active="@(tab == "general")">Allgemein</md-tab-button>
            <md-tab-button panel="player-security" icon="lock" active="@(tab == "security")">Sicherheit</md-tab-button>
            @if (!Model.IsNew)
            {
                <md-tab-button panel="player-stats" icon="bar-chart" active="@(tab == "stats")">Statistik</md-tab-button>
            }
        </md-tab-group>

        <md-tab-panel id="player-general" active="@(tab == "general")">
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="DisplayName" label="Name" required value="@Model.DisplayName" maxlength="60" />
                    <md-field name="LoginName" label="Anmeldename" required value="@Model.LoginName" maxlength="40" autocomplete="off" mono="true" />
                    <md-field name="TeamName" label="Teamname" required value="@Model.TeamName" maxlength="40" />
                    <md-field name="TeamColor" kind="colour" label="Teamfarbe" value="@Model.TeamColor" options="Model.Colors" />
                </div>
            </div>
        </md-tab-panel>

        <md-tab-panel id="player-security" active="@(tab == "security")">
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="Role" kind="radios" label="Rolle" value="@Model.Role.ToString()" options="Model.Roles" />
                    <md-field name="IsActive" kind="switch" label="Darf sich anmelden" value="@Model.IsActive.ToString()" />
                    <md-field name="Password" kind="password" label="@(Model.IsNew ? "Passwort" : "Neues Passwort")" required="@Model.IsNew" optional="@(!Model.IsNew)" autocomplete="new-password"
                              hint="@(Model.IsNew ? $"Mindestens {PlayerLogic.PasswordMinLength} Zeichen." : "Leer lassen, um das Passwort zu behalten.")" />
                </div>
            </div>
        </md-tab-panel>

        @if (!Model.IsNew && Model.Stats is { } s)
        {
            <md-tab-panel id="player-stats" active="@(tab == "stats")">
                <div class="mat-card">
                    <div class="mat-card__body">
                        <dl class="mat-kv">
                            <dt>Spiele</dt><dd class="mat-mono">@s.GamesPlayed</dd>
                            <dt>Siege</dt><dd class="mat-mono">@s.GamesWon</dd>
                            <dt>Erledigte Hasen</dt><dd class="mat-mono">@s.Kills</dd>
                            <dt>Schaden</dt><dd class="mat-mono">@s.DamageDealt</dd>
                            <dt>Letzte Anmeldung</dt><dd class="mat-mono">@Ui.Stamp(s.LastLoginDate)</dd>
                            <dt>Angelegt</dt><dd class="mat-mono">@Ui.Stamp(s.CreateDate)</dd>
                            <dt>Geändert</dt><dd class="mat-mono">@Ui.Stamp(s.UpdateDate)</dd>
                        </dl>
                    </div>
                </div>
            </md-tab-panel>
        }
    </div>

    <md-buttons save="@(Model.IsNew ? "Anlegen" : "Speichern")" back="/Admin/Players" delete-handler="@(Model.IsNew || Model.IsSelf ? null : "Delete")" delete-label="Löschen"
                delete-confirm="@($"{Model.DisplayName} wirklich löschen? Die Ergebnisse alter Spiele bleiben erhalten.")" />
</form>
