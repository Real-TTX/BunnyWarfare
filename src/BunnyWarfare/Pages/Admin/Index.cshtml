@page "/Admin"
@model BunnyWarfare.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Übersicht";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", null), ("Übersicht", null) };
}

<div class="mat-stats">
    <a class="mat-stat" href="/Admin/Players">
        <span class="mat-stat__label">@Ui.Icon("users") Spieler</span>
        <span class="mat-stat__value">@Model.Numbers.Players</span>
        <span class="mat-stat__delta">@Model.Numbers.ActivePlayers7Days aktiv in 7 Tagen</span>
    </a>
    <a class="mat-stat" href="/Admin/Matches?status=Running">
        <span class="mat-stat__label">@Ui.Icon("swords") Laufende Spiele</span>
        <span class="mat-stat__value">@Model.Numbers.MatchesRunning</span>
        <span class="mat-stat__delta">@Model.Numbers.MatchesInLobby in der Lobby · @Model.Numbers.MatchesTotal insgesamt</span>
    </a>
    <div class="mat-stat">
        <span class="mat-stat__label">@Ui.Icon("network") Verbunden</span>
        <span class="mat-stat__value">@Model.Online</span>
        <span class="mat-stat__delta">@Model.RoomsInMemory Räume im Speicher</span>
    </div>
    <a class="mat-stat" href="/Admin/Worlds">
        <span class="mat-stat__label">@Ui.Icon("globe-map") Welten &amp; Waffen</span>
        <span class="mat-stat__value">@Model.Numbers.Worlds / @Model.Numbers.Weapons</span>
        <span class="mat-stat__delta">Welten / Waffen</span>
    </a>
</div>

<section class="mat-card bw-gap">
    <div class="mat-card__head"><h2 class="mat-card__title">Live: Räume im Speicher</h2></div>
    @if (Model.Rooms.Count == 0)
    {
        <div class="mat-card__body"><p class="mat-muted">Gerade wird nicht gespielt.</p></div>
    }
    else
    {
        <md-table caption="Räume im Speicher">
            <thead>
                <tr><th scope="col">Spiel</th><th scope="col">Status</th><th scope="col">Welt</th><th scope="col" class="mat-num">Teams</th><th scope="col" class="mat-num">Verbunden</th><th scope="col" class="mat-num mat-hide-sm">Zug</th><th scope="col"><span class="mat-sr-only">Aktionen</span></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rooms)
                {
                    <tr>
                        <td data-label="Spiel"><a href="/Admin/Matches/Edit?id=@r.MatchId">@r.Name</a></td>
                        <td data-label="Status"><span class="mat-pill @(r.Status == MatchStatus.Running ? "mat-pill--warn" : "mat-pill--ok")">@MatchLogic.StatusName(r.Status)</span></td>
                        <td data-label="Welt">@r.World</td>
                        <td data-label="Teams" class="mat-num mat-mono">@r.Teams</td>
                        <td data-label="Verbunden" class="mat-num mat-mono">@r.Connections</td>
                        <td data-label="Zug" class="mat-num mat-mono mat-hide-sm">@r.Turn</td>
                        <td class="mat-table__cell-actions"><div class="mat-table__actions"><a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Play/@r.Token" aria-label="Zuschauen: @r.Name" data-tip="Zuschauen">@Ui.Icon("eye")</a></div></td>
                    </tr>
                }
            </tbody>
        </md-table>
    }
</section>
