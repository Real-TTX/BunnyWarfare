@page "/Admin/Weapons/Edit"
@model BunnyWarfare.Pages.Admin.Weapons.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neue Waffe" : Model.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", "/Admin"), ("Waffen", "/Admin/Weapons"), (Model.IsNew ? "Neu" : Model.Name, null) };
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">Waffe</h2></div>
        <div class="mat-card__body mat-form">
            <md-field name="Name" label="Name" required value="@Model.Name" maxlength="60" />
            <md-field name="Description" kind="textarea" label="Beschreibung" value="@Model.Description" maxlength="400" rows="2" optional="true" />
            <md-field name="Kind" kind="radios" label="Art" value="@Model.Kind.ToString()" options="Model.Kinds" />
            <md-field name="IsEnabled" kind="switch" label="Im Arsenal" value="@Model.IsEnabled.ToString()" />
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">Wirkung</h2></div>
        <div class="mat-card__body mat-form mat-grid mat-grid--2">
            <md-field name="Damage" kind="number" label="Schaden" required value="@Model.Damage" min="1" max="200" hint="Im Zentrum der Explosion; nach außen weniger." show-if="Kind" show-value="Projectile,Grenade,Cluster,Hitscan,Airstrike" />
            <md-field name="BlastRadius" kind="number" label="Explosionsradius (m)" required value="@Model.BlastRadius" min="0.5" max="8" step="0.1" show-if="Kind" show-value="Projectile,Grenade,Cluster,Hitscan,Airstrike" />
            @* only the fields the kind uses are shown (and posted) *@
            <md-field name="AffectedByWind" kind="switch" label="Treibt im Wind" value="@Model.AffectedByWind.ToString()" show-if="Kind" show-value="Projectile,Cluster" />
            <md-field name="FuseSeconds" kind="number" label="Zünder (Sekunden)" required value="@Model.FuseSeconds" min="1" max="6" step="0.5" show-if="Kind" show-value="Grenade" />
            <md-field name="ClusterCount" kind="number" label="Anzahl Bomben" required value="@Model.ClusterCount" min="2" max="8" show-if="Kind" show-value="Cluster,Airstrike" hint="Splitterbombe: Bomblets nach dem Aufschlag · Luftschlag: Bomben in einer Reihe." />
            <md-field name="Pellets" kind="number" label="Schrotkugeln pro Schuss" required value="@Model.Pellets" min="1" max="8" show-if="Kind" show-value="Hitscan" />
        </div>
    </div>

    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">Arsenal</h2></div>
        <div class="mat-card__body mat-form mat-grid mat-grid--2">
            <md-field name="AmmoPerMatch" kind="number" label="Munition pro Spiel" required value="@Model.AmmoPerMatch" min="-1" max="20" hint="-1 = unbegrenzt, 0 = nur aus Versorgungskisten." />
            <md-field name="SortOrder" kind="number" label="Reihenfolge" required value="@Model.SortOrder" hint="Platz in der Waffenleiste (kleiner = weiter vorn)." />
        </div>
    </div>

    <md-buttons save="@(Model.IsNew ? "Anlegen" : "Speichern")" back="/Admin/Weapons" delete-handler="@(Model.IsNew ? null : "Delete")" delete-label="Löschen"
                delete-confirm="@($"„{Model.Name}“ wirklich aus dem Arsenal löschen?")" />
</form>
