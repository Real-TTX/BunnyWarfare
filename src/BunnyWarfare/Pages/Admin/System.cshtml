@page "/Admin/System"
@model BunnyWarfare.Pages.Admin.SystemModel
@{
    ViewData["Title"] = "System";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", "/Admin"), ("System", null) };
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />

    <div data-tabs>
        <md-tab-group label="Bereiche des Systems">
            <md-tab-button panel="system-play" icon="gamepad" active="true">Spiel</md-tab-button>
            <md-tab-button panel="system-access" icon="users">Zugang</md-tab-button>
            <md-tab-button panel="system-info" icon="info">Info</md-tab-button>
        </md-tab-group>

        <md-tab-panel id="system-play" active="true">
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="DefaultTurnSeconds" kind="number" label="Zugzeit für neue Spiele (Sekunden)" required value="@Model.DefaultTurnSeconds" min="15" max="120" step="5" />
                    <md-field name="MaxTeamsPerMatch" kind="number" label="Höchstens Teams pro Spiel" required value="@Model.MaxTeamsPerMatch" min="2" max="8" />
                    <md-field name="Announcement" kind="textarea" label="Ankündigung auf der Startseite" value="@Model.Announcement" maxlength="500" rows="3" optional="true" />
                </div>
            </div>
        </md-tab-panel>

        <md-tab-panel id="system-access">
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="RegistrationOpen" kind="switch" label="Jeder darf sich registrieren" value="@Model.RegistrationOpen.ToString()" hint="Aus: neue Konten legt nur die Administration an." />
                </div>
            </div>
        </md-tab-panel>

        <md-tab-panel id="system-info">
            <div class="mat-card">
                <div class="mat-card__body">
                    <dl class="mat-kv">
                        <dt>Version</dt><dd class="mat-mono">@AppInfo.Version</dd>
                        <dt>Gestartet</dt><dd class="mat-mono">@Ui.Stamp(AppInfo.Started)</dd>
                        <dt>Port</dt><dd class="mat-mono">@AppInfo.Port</dd>
                        <dt>Laufzeit</dt><dd class="mat-mono">.NET @Environment.Version</dd>
                    </dl>
                </div>
            </div>
        </md-tab-panel>
    </div>

    <md-buttons save="Speichern" back="/Admin" />
</form>
